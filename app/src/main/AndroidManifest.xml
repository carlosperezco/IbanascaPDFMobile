<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permisos: los archivos se abren y guardan con el selector del sistema
     y los certificados instalados se piden con KeyChain. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Abrir con» desde otras apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- «Compartir»: da a la app elegida acceso de lectura solo al PDF compartido. -->
        <provider
            android:name=".ProveedorCompartir"
            android:authorities="${applicationId}.compartir"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
